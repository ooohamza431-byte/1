{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1", "fra1", "sin1"],
  "functions": {
    "app/api/chat/route.ts": { "maxDuration": 300, "memory": 1024 },
    "app/api/image/generate/route.ts": { "maxDuration": 60 },
    "app/api/admin/**/route.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
